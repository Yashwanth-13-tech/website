# ==============================================================================
# BLR CRUIZ | CAR RENTAL BANGALORE - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development.
# DO NOT commit real secrets (.env, .env.local) to GitHub or version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER WEB SERVICE (BACKEND PRODUCTION ENVIRONMENT VARIABLES)
# Configure these in Render Dashboard -> Web Service -> Environment:
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Frontend Origin URL for CORS (comma-separated or specific origin)
FRONTEND_URL=https://blrcruiz.in,https://www.blrcruiz.in

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (MANDATORY IN PRODUCTION - SINGLE SOURCE OF TRUTH)
# In Supabase Dashboard -> Settings -> Database -> Connection string -> URI (Pooled / Direct)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE (FOR CAR IMAGES)
# In Supabase Dashboard -> Settings -> API -> Project URL & Service Role Key
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=car-images

# ------------------------------------------------------------------------------
# 4. RAZORPAY ONLINE PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 5. ADMIN MASTER LOGIN CREDENTIALS (OPTIONAL CUSTOM OVERRIDE)
# ------------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS_HASH=e6da472f83d28c8486bb5e8abe2c10d76897294298881cf3162cc5569ccc0f22

# ------------------------------------------------------------------------------
# 6. VERCEL / FRONTEND CLIENT ENVIRONMENT VARIABLES
# Configure these in Vercel / Client Deployment -> Environment Variables:
# ------------------------------------------------------------------------------
VITE_API_URL=https://blrcruiz.onrender.com
VITE_RAZORPAY_KEY_ID=
