# ==============================================================================
# BLR CRUIZ | CAR RENTAL BANGALORE - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development.
# DO NOT commit real secrets (.env, .env.local) to GitHub or version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER WEB SERVICE (BACKEND ENVIRONMENT VARIABLES)
# Configure these in Render Dashboard -> Environment:
# ------------------------------------------------------------------------------
# Server Port (Render sets this automatically, default 5000 / 10000)
PORT=5000
NODE_ENV=production

# Frontend Origin URL for CORS (comma-separated or specific origin)
FRONTEND_URL=https://blrcruiz.in,https://www.blrcruiz.in

# ------------------------------------------------------------------------------
# PRODUCTION DATABASE (SINGLE SOURCE OF TRUTH)
# ------------------------------------------------------------------------------
# For permanent cross-device persistence on Render / Cloud:
# 1. In Render Dashboard -> Click 'New +' -> Select 'PostgreSQL'
# 2. Copy the 'Internal Database URL' (or 'External Database URL')
# 3. Add DATABASE_URL to your Web Service Environment Variables
# Example: postgres://username:password@dpg-xxxx-a.render.com/blrcruiz_db
# (Also supports Supabase, Neon, AWS RDS, Railway PostgreSQL)
# If left unset, the server falls back to SQLite for local development.
DATABASE_URL=

# Razorpay Credentials (from https://dashboard.razorpay.com/#/app/keys)
# Test Mode: starts with 'rzp_test_' | Live Mode: starts with 'rzp_live_'
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Admin Authentication (Optional custom credentials)
# Default password hash for 'blrcruiz2026'
ADMIN_USER=admin
ADMIN_PASS_HASH=e6da472f83d28c8486bb5e8abe2c10d76897294298881cf3162cc5569ccc0f22

# ------------------------------------------------------------------------------
# 2. VERCEL (FRONTEND ENVIRONMENT VARIABLES)
# Configure these in Vercel Project Settings -> Environment Variables:
# ------------------------------------------------------------------------------
# Backend API Base URL (Your Render Web Service URL)
# Example: https://blrcruiz-backend.onrender.com (or https://api.blrcruiz.in)
VITE_API_URL=https://your-render-service.onrender.com

# Razorpay Publishable Key for Frontend Checkout Modal
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
